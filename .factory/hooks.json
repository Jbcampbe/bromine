{
  "PostToolUse": [
    {
      "matcher": "Create|Edit|ApplyPatch",
      "hooks": [
        {
          "type": "command",
          "command": "\"$FACTORY_PROJECT_DIR\"/.factory/hooks/rust-fmt.sh",
          "timeout": 90
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Create|Edit|ApplyPatch",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$FACTORY_PROJECT_DIR\"/.factory/hooks/protect-fixtures.py",
          "timeout": 20
        }
      ]
    }
  ]
}
